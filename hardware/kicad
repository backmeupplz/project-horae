#!/bin/sh
# Run KiCad 10 tools (kicad-cli, python3 with pcbnew) in the official container; repo is mounted at /work.
# 3D models come from a local KiCad.app if present (the image ships without them).
root=$(git rev-parse --show-toplevel)
models="$HOME/Applications/KiCad/KiCad.app/Contents/SharedSupport/3dmodels"
[ -d "$models" ] && mount3d="-v $models:/usr/share/kicad/3dmodels:ro"
exec docker run --rm -i --platform linux/amd64 -u "$(id -u):$(id -g)" -e HOME=/tmp \
  -e KICAD10_3DMODEL_DIR=/usr/share/kicad/3dmodels $mount3d \
  -v "$root":/work -w "/work/$(git rev-parse --show-prefix)" kicad/kicad:10.0 \
  sh -c 'c=$HOME/.config/kicad/10.0; mkdir -p $c; cp /usr/share/kicad/template/*-lib-table $c/; exec "$@"' sh "$@"
